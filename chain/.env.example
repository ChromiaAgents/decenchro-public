# Chromia node URL (local dev or testnet)
CHROMIA_NODE_URL=http://localhost:7740

# Blockchain RID (from chr deployment create output)
CHROMIA_BRID=

# Admin private key (from chr keygen --key-id decenchro)
# Store the hex from ~/.chromia/decenchro
ADMIN_PRIVKEY=

# Agent namespace (unique per agent instance)
AGENT_NAMESPACE=decenchro-agent-001

# OpenRouter API key for embeddings. Optional: with it, memories are embedded
# on store and `search --query` (semantic recall) works on any node. Without
# it, store/recall/tag-search still work — only semantic search is unavailable.
OPENROUTER_API_KEY=

# Embedding model. Any model works — the same model just has to be used for
# both storing and querying so the vectors are comparable.
EMBEDDING_MODEL=openai/text-embedding-3-small
