# ── Database + auth (Neon) ───────────────────────────────────────────────
# On Vercel these are injected by the Neon Marketplace store (decenchro-prod on
# Production, decenchro-staging on Preview) — do not set them by hand there.
# Locally, `vercel env pull .env.local --environment=production` or paste from
# the Neon dashboard.
#
# DATABASE_URL is the POOLED endpoint (its host contains "-pooler") and is what
# the app uses. DATABASE_URL_UNPOOLED is the direct endpoint, required for
# migrations: a transaction pooler hands each statement a different backend,
# which breaks multi-statement DDL.
DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

# Neon Auth (Managed Better Auth): Google and email/password. Magic link is
# disabled in the project config (user decision 2026-08-20).
# NEON_AUTH_BASE_URL comes from the same store. NEON_AUTH_COOKIE_SECRET is yours
# and must be at least 32 characters — it signs the session-data cookie, so
# rotating it signs everyone out. Use a DIFFERENT one per environment.
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.REGION.aws.neon.tech/neondb
NEON_AUTH_COOKIE_SECRET=GENERATE-32-PLUS-CHARS

# Operator console (dashboard) write access.
# Comma-separated emails allowed to perform admin mutations (deploy, create
# agent, config writes). Authenticated users not listed get read-only (viewer).
# Leave UNSET in local/demo to treat every signed-in user as admin.
# DASHBOARD_ADMIN_EMAILS=you@company.com,ops@company.com

# ── Cloud agent provisioning (Render) ────────────────────────────────────
# Required for the "Deploy to cloud" flow. These are SERVER-ONLY secrets — set
# them in Vercel (Production/Preview) AND here for local dev. Use the SAME
# values in both so secrets encrypted in one environment decrypt in the other
# (the deployments table is shared). Tip: `vercel env pull .env.local --environment=production`.

# Render is the only host. Both are required: the API key (Account Settings →
# API Keys) and the owner id (the usr-*/tea-* the key belongs to, from
# GET /v1/owners). DigitalOcean and Hetzner were retired on 2026-08-18.
RENDER_API_KEY=rnd_...
RENDER_OWNER_ID=usr-...
# Optional. Plan floor is `standard`: the agent image does not fit in starter's
# 512 MB. Region and disk size for the agent's state volume.
RENDER_PLAN=standard
RENDER_REGION=oregon
RENDER_DISK_GB=5
# AES-256 key for encrypting agent secrets at rest. MUST be ≥32 chars.
#   openssl rand -hex 32
ENCRYPTION_KEY=AT-LEAST-32-CHARACTERS-LONG-RANDOM-STRING
# Shared secret the agent container uses to authenticate its progress callbacks.
#   openssl rand -hex 32
DEPLOY_WEBHOOK_SECRET=YOUR-WEBHOOK-SECRET
# Public base URL the agent calls back to for deploy progress. Use your stable
# domain; a Render service cannot reach http://localhost, so end-to-end webhook
# progress only works against the deployed app (or a tunnel).
APP_BASE_URL=https://decenchro.com


# ── Credits and Chromia Pay ─────────────────────────────────────────────
# Billing is prepaid credits (see lib/dashboard/credits.ts), topped up with CHR,
# USDC or USDT through Chromia Pay. Enterprise is invoiced out of band.
# Get the keys from the Chromia Pay dashboard: Developers → New key, and
# Developers → Add endpoint (point it at /api/credits/webhook).
# The store also needs a VERIFIED PAYOUT WALLET on a chain that carries the
# asset, or every createPayment fails validation with "this store has no
# verified payout wallet" — the key alone is not enough to take a payment.
CPAY_SECRET_KEY=cpay_at_test_...
CPAY_WEBHOOK_SECRET=whsec_...
CPAY_API_URL=https://pay-api.chromia.com

# ── Platform LLM ────────────────────────────────────────────────────────
# The platform supplies the LLM for every deployed agent; the operator no longer
# enters an OpenRouter key or picks a model in the deploy form.
#
# Shared OpenRouter key every agent runs on. Required for cloud deploys.
PLATFORM_OPENROUTER_API_KEY=sk-or-...
# Default model slug (openrouter.ai/models). Optional — defaults to openai/gpt-5.4-mini.
PLATFORM_MODEL_ID=openai/gpt-5.4-mini
# Which host every agent provisions on. Only `render` is supported; anything else
# falls back to it rather than silently provisioning somewhere unexpected.
DEPLOY_PROVIDER=render

# ── ERC-8004 on BNB Smart Chain ──────────────────────────────────────────
# Every deployed agent registers an ERC-8004 identity (its own derived wallet)
# and the attest cron anchors its audit summary on the ValidationRegistry.
# Registration is best-effort: leave PLATFORM_BSC_PRIVKEY unset and deploys
# work exactly as before, with no on-chain identity.
#
# Funded platform wallet: pays gas and pre-funds each agent's derived wallet
# (~0.005 tBNB per registration). Testnet faucet: bnbchain.org/en/testnet-faucet
PLATFORM_BSC_PRIVKEY=0x...
# 97 = BSC testnet (default), 56 = mainnet. The mainnet flip is this one var
# (plus a funded mainnet PLATFORM_BSC_PRIVKEY); registry addresses follow it.
BSC_CHAIN_ID=97
# Optional RPC override; defaults to publicnode per chain.
# BSC_RPC_URL=https://bsc-testnet-rpc.publicnode.com
# Opt-in MegaFuel paymaster RPC: agent-wallet registration txs go gas-free
# (gasPrice 0) through it, skipping the pre-funding transfer. Falls back to the
# funded path on any sponsorship error. Testnet endpoint shown; mainnet needs
# your own sponsorship policy on nodereal.
# BSC_MEGAFUEL_RPC_URL=https://bsc-megafuel-testnet.nodereal.io
# Optional registry overrides (default to the canonical 0x8004… proxies).
# ERC8004_IDENTITY_REGISTRY=
# ERC8004_REPUTATION_REGISTRY=
# ERC8004_VALIDATION_REGISTRY=
# 8004scan Pro API key (marketplace data; anonymous works at 10 req/min).
# SCAN8004_API_KEY=
# Protects the attest/expire/enforce-budgets crons when set.
# CRON_SECRET=

# ── Contact form (marketing "Contact us" modal → /api/contact) ───────────
# Submissions are stored in the contact_submissions table via
# the service-role client above — no email provider needed. View them in the
# Supabase table editor.
