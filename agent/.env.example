# === Required ===

# OpenRouter API key (get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxx

# Telegram bot token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Your Telegram user ID (get from @userinfobot on Telegram)
TELEGRAM_ALLOWED_USERS=123456789

# Atbash agent private key — onboard your agent at
# https://atbash.ai/risk-engine/agents (the dashboard generates the keypair,
# assigns the agent to your org, and attaches a policy pack).
ATBASH_AGENT_KEY=

# === Optional ===

# Atbash org name (only needed if you belong to multiple orgs)
# ATBASH_ORG_NAME=

# decenchro-guard plugin tuning. See agent/plugins/decenchro-guard/README.md.
#   Comma-separated allowlist of tool names to route through the judge.
# ATBASH_GUARDED_TOOLS=terminal,read_file,write_file,patch,search_files,web_search,web_extract,decenchro-mem
#   "1" → always allow after logging the verdict (first-deploy mode).
# ATBASH_AUDIT_ONLY=0
#   "1" → allow tool calls when the judge errors. Default fails closed.
# ATBASH_FAIL_OPEN=0
#   Override judge endpoint (rarely needed).
# ATBASH_ENDPOINT=


# Telegram channel for scheduled task results
# TELEGRAM_HOME_CHANNEL=

# Web search (pick one)
# FIRECRAWL_API_KEY=
# TAVILY_API_KEY=

# Chromia admin private key (for on-chain memory operations)
# Generated by: chr keygen --key-id decenchro
# CHROMIA_ADMIN_PRIVKEY=


# === BSC DeFi (bsc-defi CLI + the bsc-* skills) ===

# Agent wallet private key on BNB Chain (0x-prefixed 32-byte hex). On managed
# deployments the platform derives and injects this per deployment. Unset,
# the DeFi skills run read-only (monitoring works, trading refuses cleanly).
# BSC_AGENT_KEY=

# 97 = BSC testnet (default), 56 = mainnet.
# BSC_CHAIN_ID=97

# Optional RPC override. Defaults per chain:
#   97 → https://bsc-testnet-rpc.publicnode.com
#   56 → https://bsc-rpc.publicnode.com
# BSC_RPC_URL=

# Slippage cap for swaps/LP, in basis points (default 100 = 1%).
# BSC_MAX_SLIPPAGE_BPS=100

# Max BNB/WBNB that may leave the wallet per CLI invocation (default 0.5).
# BSC_MAX_SPEND_BNB=0.5

# Safety interlock: writes on chain 56 refuse unless this is exactly "1".
# BSC_MAINNET_OK=0

# Grid/state directory (default $HERMES_HOME/workspace/.bsc-defi).
# BSC_STATE_DIR=
